      "html": "<span class=\"ds-btn-off\">Próximo</span>",
      "css": ".ds-btn-off{display:inline-flex;font-family:var(--sans);font-size:13px;font-weight:500;color:var(--tinta-3);background:var(--lavado);border:1px dashed var(--fio-forte);border-radius:var(--raio);padding:5px 11px;cursor:not-allowed}"
    },
    {
      "name": "Seletor segmentado",
      "kind": "chip",
      "refersTo": "segmento",
      "description": "Filtros de grupo, modalidade e ordem.",
      "html": "<div class=\"ds-seg\"><label class=\"ds-on\">Todas</label><label>Fomento</label><label>Prêmio</label></div>",
      "css": ".ds-seg{display:inline-flex;border:1px solid var(--fio-forte);border-radius:var(--raio);background:var(--papel);overflow:hidden}.ds-seg label{cursor:pointer;padding:5px 11px;font-family:var(--sans);font-size:13px;font-weight:500;color:var(--tinta-2);border-right:1px solid var(--fio-forte);transition:background .15s,color .15s}.ds-seg label:last-child{border-right:0}.ds-seg label:hover{background:var(--lavado);color:var(--tinta)}.ds-seg label.ds-on{background:var(--tinta);color:#fff}"
    },
    {
      "name": "Busca",
      "kind": "input",
      "refersTo": "busca",
      "description": "Busca por ente, arquivo ou objeto.",
      "html": "<input class=\"ds-busca\" placeholder=\"Buscar ente, arquivo ou objeto\">",
      "css": ".ds-busca{width:280px;max-width:100%;font-family:var(--sans);font-size:13px;color:var(--tinta);border:1px solid var(--fio-forte);border-radius:var(--raio);padding:6px 10px;background:var(--papel)}.ds-busca::placeholder{color:var(--tinta-3)}.ds-busca:focus{outline:2px solid var(--verde);outline-offset:-1px;border-color:var(--verde)}"
    },
    {
      "name": "Trilho de navegação",
      "kind": "nav",
      "refersTo": "trilho-item",
      "description": "Navegação principal em verde institucional.",
      "html": "<nav class=\"ds-trilho\"><div class=\"ds-sec\">Painel</div><a class=\"ds-on\" href=\"#\">Visão geral</a><a href=\"#\">Estados e DF <span>25</span></a><a href=\"#\">Capitais <span>25</span></a></nav>",
      "css": ".ds-trilho{background:var(--verde);color:var(--verde-txt);width:232px;padding:8px 0;font-family:var(--sans);font-size:14px}.ds-sec{font-size:11.5px;font-weight:600;text-transform:uppercase;letter-spacing:.09em;color:#bcd3c6;padding:12px 22px 6px}.ds-trilho a{display:flex;justify-content:space-between;padding:9px 22px;font-weight:500;color:inherit;text-decoration:none;transition:background .15s}.ds-trilho a span{font-size:12.5px;color:#c6dccf}.ds-trilho a:hover{background:rgba(255,255,255,.07);color:#fff}.ds-trilho a.ds-on{background:var(--verde-2);color:#fff;box-shadow:inset 3px 0 0 #fff}.ds-trilho a:focus-visible{outline:2px solid #fff;outline-offset:-3px}"
    },
    {
      "name": "Abas",
      "kind": "nav",
      "refersTo": "aba",
      "description": "Abas de situação na revisão.",
      "html": "<div class=\"ds-abas\"><a class=\"ds-aba ds-aba-on\" href=\"#\">Não conformes <span>82</span></a><a class=\"ds-aba\" href=\"#\">Indeterminados <span>15</span></a></div>",
      "css": ".ds-abas{display:flex;gap:2px;border-bottom:1px solid var(--fio)}.ds-aba{padding:8px 14px 9px;font-family:var(--sans);font-weight:500;font-size:13.5px;color:var(--tinta-2);text-decoration:none;border-bottom:2px solid transparent;margin-bottom:-1px;display:flex;gap:8px}.ds-aba span{color:var(--tinta-3);font-size:12.5px}.ds-aba:hover{color:var(--tinta);border-bottom-color:var(--fio-forte)}.ds-aba:focus-visible{outline:2px solid var(--verde);outline-offset:2px}.ds-aba-on{color:var(--tinta);font-weight:600;border-bottom-color:var(--verde)}"
    },
    {
