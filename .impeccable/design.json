    {
      "name": "Botão",
      "kind": "button",
      "refersTo": "botao",
      "description": "Ação de navegação na ficha (Anterior/Próximo).",
      "html": "<a class=\"ds-btn\" href=\"#\"><span class=\"ds-ico\"></span>Anterior</a>",
      "css": ".ds-btn{display:inline-flex;align-items:center;gap:6px;font-family:var(--sans);font-size:13px;font-weight:500;color:var(--tinta);text-decoration:none;border:1px solid var(--fio-forte);border-radius:var(--raio);padding:5px 11px;background:var(--papel);transition:background .15s,border-color .15s}.ds-btn:hover{background:var(--lavado);border-color:var(--tinta-3)}.ds-btn:focus-visible{outline:2px solid var(--verde);outline-offset:2px}.ds-ico{width:7px;height:7px;border-left:1.6px solid currentColor;border-bottom:1.6px solid currentColor;transform:rotate(45deg);margin-left:2px}"
    },
    {
      "name": "Botão desligado",
      "kind": "button",
      "refersTo": "botao-desligado",
