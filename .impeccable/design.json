      "html": "<p class=\"ds-ementa\"><span class=\"ds-par\" tabindex=\"0\">§3º<span class=\"ds-par-txt\"><b>IN 5, §3º</b> Texto resumido do parágrafo.</span></span>1 edital: categorias abaixo do mínimo</p>",
      "css": ".ds-ementa{font-family:var(--serif);font-size:13px;color:var(--tinta-2);margin:0 0 90px}.ds-par{position:relative;display:inline-block;font:600 11.5px/1.5 var(--sans);color:var(--verde);border:1px solid #b2cbbe;background:var(--verde-3);padding:0 5px;border-radius:2px;margin-right:6px;cursor:help}.ds-par-txt{position:absolute;z-index:5;left:0;top:calc(100% + 6px);width:280px;background:var(--tinta);color:#f1f3f4;font:400 12.5px/1.45 var(--sans);padding:9px 11px;border-radius:var(--raio);box-shadow:0 6px 18px rgba(16,24,32,.22);opacity:0;transform:translateY(-3px);pointer-events:none;transition:opacity .16s var(--sai),transform .16s var(--sai)}.ds-par-txt b{color:#fff;font-weight:600}.ds-par:hover .ds-par-txt,.ds-par:focus .ds-par-txt{opacity:1;transform:none}.ds-par:focus-visible{outline:2px solid var(--verde);outline-offset:2px}"
    },
